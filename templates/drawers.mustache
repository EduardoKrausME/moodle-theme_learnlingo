{{!
    @template theme_learnlingo/drawers

    Boost drawer template.

    Context variables required for this template:
    * sitename - The name of the site
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * sidepreblocks - HTML for the blocks
    * hasblocks - true if there are blocks on this page
    * courseindexopen - true if the nav drawer should be open on page load
    * regionmainsettingsmenu - HTML for the region main settings menu
    * hasregionmainsettingsmenu - There is a region main settings menu on this page.

    Example context (json):
    {
        "sitename": "Moodle",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Headings make html validators happier</h1>"
         },
        "bodyattributes":"",
        "sidepreblocks": "<h2>Blocks html goes here</h2>",
        "hasblocks":true,
        "courseindexopen": true,
        "navdraweropen": false,
        "blockdraweropen": true,
        "regionmainsettingsmenu": "",
        "hasregionmainsettingsmenu": false,
        "addblockbutton": ""
    }
}}
{{> theme_learnlingo/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{> theme_learnlingo/navbar }}
    {{#courseindex}}
        {{< theme_learnlingo/drawer }}
            {{$id}}theme_learnlingo-drawers-courseindex{{/id}}
            {{$drawerheadercontent}}
                {{> theme_boost/courseindexdrawercontrols}}
            {{/drawerheadercontent}}
            {{$drawerheading}}{{> theme_learnlingo/courseindexdrawerheading}}{{/drawerheading}}
            {{$drawerclasses}}drawer drawer-left {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{{courseindex}}}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
            {{$closebuttonicon}}
                <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
            {{/closebuttonicon}}
        {{/ theme_learnlingo/drawer}}
    {{/courseindex}}
    {{#hasblocks}}
        {{< theme_learnlingo/drawer }}
            {{$id}}theme_learnlingo-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
            {{$closebuttonicon}}
                <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
            {{/closebuttonicon}}
        {{/ theme_learnlingo/drawer}}
    {{/hasblocks}}
    <div id="page" data-region="mainpage" data-usertour="scroller"
         class="drawers {{#courseindexopen}}show-drawer-left{{/courseindexopen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            <div class="drawer-toggles d-flex">
                {{#courseindex}}
                    <div class="drawer-toggler drawer-left-toggle open-nav d-print-none">
                        <button
                                class="btn btn-icon icon-size-3"
                                data-toggler="drawers"
                                data-action="toggle"
                                data-target="theme_learnlingo-drawers-courseindex"
                                data-bs-toggle="tooltip"
                                data-bs-placement="right"
                                title="{{#str}}opendrawerindex, core{{/str}}">
                            <span class="visually-hidden">{{#str}}opendrawerindex, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                        </button>
                    </div>
                {{/courseindex}}
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ms-auto d-print-none">
                        <button
                                class="btn btn-icon icon-size-3"
                                data-toggler="drawers"
                                data-action="toggle"
                                data-target="theme_learnlingo-drawers-blocks"
                                data-bs-toggle="tooltip"
                                data-bs-placement="right"
                                title="{{#str}}opendrawerblocks, core{{/str}}">
                            <span class="visually-hidden">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>
            {{#dashboardhero}}
                <section class="learnlingo-dashboard-grid" aria-label="{{dashboardeyebrow}}">
                    <div class="learnlingo-dashboard-hero">
                        <div class="learnlingo-dashboard-copy">
                            <span class="learnlingo-eyebrow">
                                <i class="fa fa-star" aria-hidden="true"></i>
                                {{dashboardeyebrow}}
                            </span>
                            <h1 class="learnlingo-dashboard-title">{{dashboardtitle}}</h1>
                            <p class="learnlingo-dashboard-description">{{dashboarddescription}}</p>
                            <a class="learnlingo-dashboard-cta" href="{{{coursesurl}}}">
                                {{dashboardcta}}
                                <i class="fa fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                        <div class="learnlingo-hero-illustration" aria-hidden="true">
                            <i class="fa fa-graduation-cap"></i>
                        </div>
                    </div>
                    <aside class="learnlingo-goal-card">
                        <div class="learnlingo-goal-heading">
                            <span class="learnlingo-goal-icon" aria-hidden="true">
                                <i class="fa fa-clock-o"></i>
                            </span>
                            <span>
                                <span class="learnlingo-goal-kicker">{{dashboardeyebrow}}</span>
                                <strong class="learnlingo-goal-title">{{goaltitle}}</strong>
                            </span>
                        </div>
                        <div class="learnlingo-goal-ring" aria-hidden="true">
                            <div class="learnlingo-goal-ring-inner">
                                <strong>{{goaltime}}</strong>
                                <small>{{goaltitle}}</small>
                            </div>
                        </div>
                        <p class="learnlingo-goal-copy">{{goalsubtitle}}</p>
                        <a class="btn btn-primary" href="{{{coursesurl}}}">{{goalcta}}</a>
                    </aside>
                </section>
            {{/dashboardhero}}
            {{#coursehero}}
                <section class="learnlingo-course-hero {{#courseheroimage}}has-image{{/courseheroimage}}">
                    <div class="learnlingo-course-hero-copy">
                        <span class="learnlingo-course-eyebrow">
                            <i class="fa fa-bolt" aria-hidden="true"></i>
                            {{courseheroeyebrow}}
                        </span>
                        <h1 class="learnlingo-course-title">{{coursefullname}}</h1>
                        {{#courseherosummary}}
                            <p class="learnlingo-course-summary">{{courseherosummary}}</p>
                        {{/courseherosummary}}
                    </div>
                    {{#courseheroimage}}
                        <div class="learnlingo-course-hero-media" aria-hidden="true">
                            <img src="{{{courseheroimage}}}" alt="">
                        </div>
                    {{/courseheroimage}}
                    <span class="learnlingo-course-decoration decoration-one" aria-hidden="true"></span>
                    <span class="learnlingo-course-decoration decoration-two" aria-hidden="true"></span>
                </section>
                {{#coursestats}}
                    <section class="learnlingo-course-stats" aria-label="{{courseprogressheading}}">
                        {{#courseprogressavailable}}
                            <div class="learnlingo-course-progress-summary">
                                <div
                                        class="learnlingo-course-progress-ring"
                                        style="--learnlingo-course-progress: {{courseprogress}}%;"
                                        role="img"
                                        aria-label="{{courseprogresslabel}}">
                                    <span>{{courseprogress}}%</span>
                                </div>
                                <div class="learnlingo-course-progress-copy">
                                    <div class="learnlingo-course-progress-heading">
                                        <strong>{{courseprogressheading}}</strong>
                                        <span>{{courseprogresslabel}}</span>
                                    </div>
                                    <div class="learnlingo-course-progress-track" aria-hidden="true">
                                        <span style="width: {{courseprogress}}%;"></span>
                                    </div>
                                </div>
                            </div>
                        {{/courseprogressavailable}}
                        {{#personalxp}}
                            <a class="learnlingo-course-stat learnlingo-course-stat-xp" href="{{{url}}}">
                                <span class="learnlingo-course-stat-icon" aria-hidden="true">
                                    <i class="fa fa-star"></i>
                                </span>
                                <span class="learnlingo-course-stat-copy">
                                    <strong>{{totalxp}}</strong>
                                    <small>{{personalxpincourselabel}}</small>
                                </span>
                            </a>
                            <a class="learnlingo-course-stat learnlingo-course-stat-level" href="{{{url}}}">
                                <span class="learnlingo-course-stat-icon" aria-hidden="true">
                                    <i class="fa fa-trophy"></i>
                                </span>
                                <span class="learnlingo-course-stat-copy">
                                    <strong>{{currentlevel}}</strong>
                                    <small>{{personalxplevellabel}}</small>
                                    <span class="learnlingo-level-progress" aria-hidden="true">
                                        <span style="width: {{levelprogress}}%;"></span>
                                    </span>
                                    <span class="learnlingo-level-next">{{nextlabel}}</span>
                                </span>
                            </a>
                            {{#personalxpactivityreward}}
                                <span
                                        class="d-none"
                                        data-learnlingo-xp-reward="{{personalxpactivityrewardlabel}}">
                                </span>
                            {{/personalxpactivityreward}}
                        {{/personalxp}}
                    </section>
                {{/coursestats}}
            {{/coursehero}}
            {{#showfullheader}}
                {{{ output.full_header }}}
            {{/showfullheader}}
            {{#secondarymoremenu}}
                <div class="secondary-navigation d-print-none">
                    {{> core/moremenu}}
                </div>
            {{/secondarymoremenu}}
            <div id="page-content" class="pb-3 d-print-block">
                <div id="region-main-box">
                    {{#hasregionmainsettingsmenu}}
                        <div id="region-main-settings-menu" class="d-print-none">
                            <div> {{{ regionmainsettingsmenu }}} </div>
                        </div>
                    {{/hasregionmainsettingsmenu}}
                    <div id="region-main">

                        {{#hasregionmainsettingsmenu}}
                            <div class="region_main_settings_menu_proxy"></div>
                        {{/hasregionmainsettingsmenu}}
                        {{{ output.course_content_header }}}
                        {{#headercontent}}
                            {{> core/activity_header }}
                        {{/headercontent}}
                        {{#overflow}}
                            <div class="container-fluid tertiary-navigation">
                                <div class="navitem">
                                    {{> core/tertiary_navigation_selector}}
                                </div>
                            </div>
                        {{/overflow}}
                        {{{ output.main_content }}}
                        {{{ output.activity_navigation }}}
                        {{{ output.course_content_footer }}}

                    </div>
                </div>
            </div>
        </div>
        {{> theme_learnlingo/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>

</body>
</html>
{{#js}}
    M.util.js_pending('theme_boost/loader');
    require(['theme_boost/loader', 'theme_boost/drawer'], function (Loader, Drawer) {
        Drawer.init();
        M.util.js_complete('theme_boost/loader');
    });

    (function () {
        const decoratePersonalXpRewards = function () {
            const config = document.querySelector('[data-learnlingo-xp-reward]');
            if (!config) {
                return;
            }

            const reward = config.getAttribute('data-learnlingo-xp-reward');
            if (!reward) {
                return;
            }

            document.querySelectorAll('.course-content .activity-item').forEach(function (item) {
                if (!item.querySelector('.activity-completion')) {
                    return;
                }

                const title = item.querySelector('.activitytitle');
                if (!title || title.querySelector('.learnlingo-xp-reward')) {
                    return;
                }

                title.classList.add('learnlingo-activity-title-with-xp');
                const chip = document.createElement('span');
                chip.className = 'learnlingo-xp-reward';
                chip.textContent = reward;
                title.appendChild(chip);
            });
        };

        decoratePersonalXpRewards();

        const courseContent = document.querySelector('.course-content');
        if (courseContent && window.MutationObserver) {
            const observer = new MutationObserver(decoratePersonalXpRewards);
            observer.observe(courseContent, {childList: true, subtree: true});
        }
    })();
{{/js}}
