<aside class="mcp-promo" aria-labelledby="theme_learnlingo-mcp-title">
    <div class="mcp-promo__icon" aria-hidden="true">MCP</div>
    <div class="mcp-promo__content">
        <span class="mcp-promo__badge">{{#str}}mcp_banner_badge,theme_learnlingo{{/str}}</span>
        <h3 id="theme_learnlingo-mcp-title">{{#str}}mcp_banner_title,theme_learnlingo{{/str}}</h3>
        <p>{{#str}}mcp_banner_description,theme_learnlingo{{/str}}</p>
        <ul>
            <li>{{#str}}mcp_banner_benefit_discovery,theme_learnlingo{{/str}}</li>
            <li>{{#str}}mcp_banner_benefit_security,theme_learnlingo{{/str}}</li>
            <li>{{#str}}mcp_banner_benefit_control,theme_learnlingo{{/str}}</li>
        </ul>
        <a class="mcp-promo__link" href="https://eduardokrausme.github.io/moodle-local_mcp/"
           target="_blank" rel="noopener noreferrer">{{#str}}mcp_banner_cta,theme_learnlingo{{/str}} &#8599;</a>
    </div>
    <div class="mcp-promo__close">
        <button class="mcp-promo__dismiss" type="submit"
            formaction="{{mcp_banner_dismiss_url}}" formmethod="post"
            name="dismiss_mcp_banner" value="1"
            aria-label="{{#str}}mcp_banner_dismiss,theme_learnlingo{{/str}}"
            title="{{#str}}mcp_banner_dismiss,theme_learnlingo{{/str}}">&times;</button>
    </div>
</aside>
