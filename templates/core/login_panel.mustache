{{!
    @template theme_learnlingo/core/login_panel

    Default content for the left panel of the split-screen login layout.

    When leftinstructions is provided (i.e. the site has custom auth instructions configured),
    it fully replaces the entire default welcome section (title, tagline, and stats).

    Example context (json):
    {
        "leftinstructions": "<p>Welcome to our learning platform. Please log in to continue.</p>"
    }
}}
<div class="login-layout-left-content">
    <div class="pulsomed-login-brand">
        {{#loginlogo}}
            <img src="{{{loginlogo}}}" class="pulsomed-login-logo" alt="{{sitename}}">
        {{/loginlogo}}
        {{^loginlogo}}
        <span class="pulsomed-brandmark" aria-hidden="true"><i class="fa fa-heartbeat"></i></span>
        <span class="pulsomed-wordmark">PULSO<span class="pulsomed-wordmark-accent">MED</span></span>
        {{/loginlogo}}
    </div>
    {{^leftinstructions}}
        <span class="pulsomed-login-kicker">{{#str}}dashboardeyebrow, theme_learnlingo{{/str}}</span>
        <h1>{{#str}}loginpaneltitle, theme_learnlingo{{/str}}</h1>
        <p class="pulsomed-login-description">{{#str}}loginpaneldescription, theme_learnlingo{{/str}}</p>
        <ul class="pulsomed-login-benefits">
            <li><i class="fa fa-bolt" aria-hidden="true"></i>{{#str}}loginbenefitone, theme_learnlingo{{/str}}</li>
            <li><i class="fa fa-map-signs" aria-hidden="true"></i>{{#str}}loginbenefittwo, theme_learnlingo{{/str}}</li>
            <li><i class="fa fa-line-chart" aria-hidden="true"></i>{{#str}}loginbenefitthree, theme_learnlingo{{/str}}</li>
        </ul>
        <p class="pulsomed-login-tagline">{{#str}}loginpaneltagline, theme_learnlingo{{/str}}</p>
    {{/leftinstructions}}
    {{#leftinstructions}}
        <div class="mx-auto text-start">
            {{{leftinstructions}}}
        </div>
    {{/leftinstructions}}
</div>
