{{!
    @template theme_learnlingo/frontpage

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="learnlingo-home">
    {{#showwelcome}}
        <section class="learnlingo-dashboard-grid" aria-label="{{dashboardeyebrow}}">
            <div class="learnlingo-dashboard-hero">
                <div class="learnlingo-dashboard-copy">
                    <span class="learnlingo-eyebrow">
                        <i class="fa fa-star" aria-hidden="true"></i>
                        {{dashboardeyebrow}}
                    </span>
                    <h1 class="learnlingo-dashboard-title">{{dashboardtitle}}</h1>
                    <p class="learnlingo-dashboard-description">{{dashboarddescription}}</p>
                    <a class="learnlingo-dashboard-cta" href="{{{mycoursesurl}}}">
                        {{dashboardcta}}
                        <i class="fa fa-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>
                <div class="learnlingo-hero-illustration" aria-hidden="true">
                    <i class="fa fa-graduation-cap"></i>
                </div>
            </div>
            <aside class="learnlingo-goal-card">
                <div class="learnlingo-goal-heading">
                    <span class="learnlingo-goal-icon" aria-hidden="true">
                        <i class="fa fa-clock-o"></i>
                    </span>
                    <span>
                        <span class="learnlingo-goal-kicker">{{dashboardeyebrow}}</span>
                        <strong class="learnlingo-goal-title">{{goaltitle}}</strong>
                    </span>
                </div>
                <div class="learnlingo-goal-ring" aria-hidden="true">
                    <div class="learnlingo-goal-ring-inner">
                        <strong>{{goaltime}}</strong>
                        <small>{{goaltitle}}</small>
                    </div>
                </div>
                <p class="learnlingo-goal-copy">{{goalsubtitle}}</p>
                <a class="btn btn-primary" href="{{{mycoursesurl}}}">{{goalcta}}</a>
            </aside>
        </section>
    {{/showwelcome}}

    {{#hasfeaturedcourse}}
        <section class="learnlingo-resume-card" aria-label="{{featuredlabel}}">
            <div class="learnlingo-resume-icon" aria-hidden="true">
                <i class="fa fa-book"></i>
            </div>
            <div class="learnlingo-resume-main">
                <span class="learnlingo-resume-label">{{featuredlabel}}</span>
                <a class="learnlingo-resume-title" href="{{{featuredcourse.url}}}">{{featuredcourse.fullname}}</a>
                <span class="learnlingo-resume-category">{{featuredcourse.categoryname}}</span>
                {{#featuredcourse.hasxp}}
                    <a class="learnlingo-course-xp" href="{{{featuredcourse.xpurl}}}">
                        <i class="fa fa-star" aria-hidden="true"></i> {{featuredcourse.xptext}}
                    </a>
                {{/featuredcourse.hasxp}}
                {{#featuredcourse.hasprogress}}
                    <div class="learnlingo-resume-progress">
                        <div class="progress" role="progressbar" aria-label="{{featuredcourse.progresslabel}}"
                                aria-valuenow="{{featuredcourse.progress}}" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: {{featuredcourse.progress}}%"></div>
                        </div>
                        <strong>{{featuredcourse.progresslabel}}</strong>
                    </div>
                {{/featuredcourse.hasprogress}}
            </div>
            <a class="learnlingo-resume-action" href="{{{featuredcourse.url}}}" aria-label="{{featuredaction}}: {{featuredcourse.fullname}}">
                <i class="fa fa-play" aria-hidden="true"></i>
            </a>
        </section>
    {{/hasfeaturedcourse}}

    <section class="learnlingo-home-courses">
        <div class="learnlingo-home-section-heading">
            <div>
                <span>{{courseseyebrow}}</span>
                <h2>{{coursestitle}}</h2>
            </div>
            <a href="{{{allcoursesurl}}}">{{allcoursestext}} <i class="fa fa-arrow-right" aria-hidden="true"></i></a>
        </div>

        {{#hascourses}}
            <div class="learnlingo-home-course-grid">
                {{#courses}}
                    <article class="learnlingo-course-card">
                        <a class="learnlingo-course-card-media {{toneclass}}" href="{{{url}}}" tabindex="-1" aria-hidden="true">
                            {{#hasimage}}
                                <img src="{{{imageurl}}}" alt="" loading="lazy">
                            {{/hasimage}}
                            {{^hasimage}}
                                <i class="fa fa-book" aria-hidden="true"></i>
                            {{/hasimage}}
                            <span>{{categoryname}}</span>
                        </a>
                        <div class="learnlingo-course-card-body">
                            <span class="learnlingo-course-card-kicker">{{shortname}}</span>
                            <h3><a href="{{{url}}}">{{fullname}}</a></h3>
                            {{#hasxp}}
                                <a class="learnlingo-course-xp" href="{{{xpurl}}}">
                                    <i class="fa fa-star" aria-hidden="true"></i> {{xptext}}
                                </a>
                            {{/hasxp}}
                            {{#hasprogress}}
                                <div class="learnlingo-course-card-progress">
                                    <div class="progress" role="progressbar" aria-label="{{progresslabel}}"
                                            aria-valuenow="{{progress}}" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: {{progress}}%"></div>
                                    </div>
                                    <span>{{progresslabel}}</span>
                                </div>
                            {{/hasprogress}}
                            <a class="learnlingo-course-card-action" href="{{{url}}}">
                                {{courseaction}} <i class="fa fa-arrow-right" aria-hidden="true"></i>
                            </a>
                        </div>
                    </article>
                {{/courses}}
            </div>
        {{/hascourses}}

        {{#showempty}}
            <div class="learnlingo-home-empty">
                <i class="fa fa-book" aria-hidden="true"></i>
                <div>
                    <h3>{{emptytitle}}</h3>
                    <p>{{emptydescription}}</p>
                </div>
                <a class="btn btn-primary" href="{{{allcoursesurl}}}">{{allcoursestext}}</a>
            </div>
        {{/showempty}}
    </section>
</div>
