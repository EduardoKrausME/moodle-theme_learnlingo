{{!
    @template theme_learnlingo/footer

    Configurable footer adapted from theme_eadtraining.
    Example context (json):
    {
        "footercount": 2,
        "footercontents": [
            {"footertitle": "About", "footerhtml": "<p>About</p>"},
            {"footertitle": "Contact", "footerhtml": "<p>Contact</p>"}
        ],
        "footer_show_copywriter": true
    }
}}
<footer id="page-footer" class="learnlingo-site-footer">
    {{#footercount}}
        <div class="footer-container footer-container-{{footercount}} container">
            {{#footercontents}}
                <section class="footer-section-wrapper">
                    {{#footertitle}}
                        <h2 class="footer-title">{{{footertitle}}}</h2>
                    {{/footertitle}}
                    <div class="footer-section-content">{{{footerhtml}}}</div>
                </section>
            {{/footercontents}}
        </div>
    {{/footercount}}

    {{#show_home_footer_html}}
        <div class="learnlingo-home-footer-html container">{{{home_footer_html}}}</div>
    {{/show_home_footer_html}}

    {{#footer_show_copywriter}}
        <div class="footer-foot">
            <div class="container">
                <p class="text-center">
                    {{#str}}footer_copywriter,theme_learnlingo{{/str}}
                    <a href="https://eduardokraus.com" target="_blank" rel="noopener noreferrer">Eduardo Kraus</a>
                    - Powered by <a href="https://moodle.org" target="_blank" rel="noopener noreferrer">Moodle</a>
                </p>
            </div>
        </div>
    {{/footer_show_copywriter}}

    <div class="footer-content-debugging footer-dark bg-dark text-light d-none">
        <div class="container-fluid footer-dark-inner">
            {{{ output.debug_footer_html }}}
            {{{ output.standard_footer_html }}}
        </div>
    </div>
</footer>
{{{ output.standard_end_of_body_html }}}
