{{!
    @template theme_learnlingo/setting_storedfilemodern

    One image editor. Uploads and deletions use theme_learnlingo's protected
    endpoint and Moodle's File API; no YUI filemanager is rendered.

    Example context (json):
    {
        "id": "id_s_theme_learnlingo_loginlogo",
        "name": "s_theme_learnlingo_loginlogo",
        "draftid": 1234,
        "readonly": false,
        "haspreview": true,
        "filename": "logo.png",
        "previewurl": "/draftfile.php/5/user/draft/1234/logo.png",
        "accept": ".png,.jpg,.jpeg,.webp,.svg",
        "uploadurl": "/theme/learnlingo/admin/storedfile_upload.php",
        "sesskey": "test"
    }
}}
<div class="ll-storedfile" data-ll-storedfile
    data-setting="{{name}}"
    data-upload-url="{{uploadurl}}"
    data-sesskey="{{sesskey}}"
    data-current-label="{{#str}}filemoderncurrent, theme_learnlingo{{/str}}"
    data-empty-label="{{#str}}filemodernempty, theme_learnlingo{{/str}}"
    data-new-label="{{#str}}filemodernnew, theme_learnlingo{{/str}}"
    data-no-image-label="{{#str}}filemodernnoimage, theme_learnlingo{{/str}}"
    data-delete-confirm="{{#str}}filemoderndeleteconfirm, theme_learnlingo{{/str}}"
    data-uploading-label="{{#str}}filemodernuploading, theme_learnlingo{{/str}}"
    data-deleting-label="{{#str}}filemoderndeleting, theme_learnlingo{{/str}}"
    data-uploaded-label="{{#str}}filemodernuploaded, theme_learnlingo{{/str}}"
    data-deleted-label="{{#str}}filemoderndeleted, theme_learnlingo{{/str}}"
    data-error-label="{{#str}}filemodernuploaderror, theme_learnlingo{{/str}}">
    <input type="hidden" name="{{name}}" id="{{id}}" value="{{draftid}}"
        data-file-draft {{#readonly}}disabled{{/readonly}}>
    <div class="ll-storedfile__surface" data-file-dropzone>
        <div class="ll-storedfile__visual" data-file-canvas data-background="neutral">
            <img class="ll-storedfile__image" data-file-image
                {{#haspreview}}src="{{previewurl}}"{{/haspreview}}
                alt="{{filename}}" {{^haspreview}}hidden{{/haspreview}}>
            <span class="ll-storedfile__placeholder" data-file-empty
                {{#haspreview}}hidden{{/haspreview}} aria-hidden="true">
                <i class="fa fa-image"></i>
            </span>
        </div>
        <div class="ll-storedfile__content">
            <span class="ll-storedfile__state" data-file-state>
                {{#haspreview}}{{#str}}filemoderncurrent, theme_learnlingo{{/str}}{{/haspreview}}
                {{^haspreview}}{{#str}}filemodernempty, theme_learnlingo{{/str}}{{/haspreview}}
            </span>
            <strong class="ll-storedfile__name" data-file-name>
                {{#haspreview}}{{filename}}{{/haspreview}}
                {{^haspreview}}{{#str}}filemodernnoimage, theme_learnlingo{{/str}}{{/haspreview}}
            </strong>
            <span class="ll-storedfile__drop-hint">{{#str}}filemoderndrop, theme_learnlingo{{/str}}</span>
            <div class="ll-storedfile__actions">
                <button type="button" class="btn btn-primary ll-storedfile__choose"
                    data-file-choose {{#readonly}}disabled{{/readonly}}>
                    <i class="fa fa-folder-open" aria-hidden="true"></i>
                    {{#str}}filemodernchoose, theme_learnlingo{{/str}}
                </button>
                <button type="button" class="btn btn-outline-danger ll-storedfile__delete"
                    data-file-delete {{^haspreview}}hidden{{/haspreview}} {{#readonly}}disabled{{/readonly}}>
                    <i class="fa fa-trash" aria-hidden="true"></i>
                    {{#str}}filemoderndelete, theme_learnlingo{{/str}}
                </button>
            </div>
            <small class="ll-storedfile__footnote">
                {{#str}}filemoderncontrast, theme_learnlingo{{/str}}
            </small>
        </div>
    </div>
    <input type="file" class="ll-storedfile__file-input"
        accept="{{accept}}" data-file-input tabindex="-1"
        aria-label="{{#str}}filemodernchoose, theme_learnlingo{{/str}}"
        {{#readonly}}disabled{{/readonly}}>
    <div class="ll-storedfile__status" data-file-status role="status" aria-live="polite"></div>
</div>
