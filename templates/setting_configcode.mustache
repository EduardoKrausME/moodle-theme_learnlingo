{{!
    @template theme_learnlingo/setting_configcode

    An accessible native textarea, progressively enhanced with source highlighting.
    The actual textarea remains the only form control and submits unchanged text.

    Example context (json):
    {
        "id": "id_s_theme_learnlingo_homepagehtml",
        "name": "s_theme_learnlingo_homepagehtml",
        "value": "<h1>Hello</h1>",
        "cols": "90",
        "rows": "16",
        "language": "html",
        "languageupper": "HTML",
        "readonly": false
    }
}}
<div class="ll-code-editor" data-ll-code-editor data-language="{{language}}">
    <div class="ll-code-editor__toolbar">
        <span class="ll-code-editor__language">{{languageupper}}</span>
        <span class="ll-code-editor__lines" data-code-lines aria-live="off"></span>
        <button class="ll-code-editor__expand" data-code-expand type="button"
            aria-pressed="false" aria-label="{{#str}}codeeditorfullscreen, theme_learnlingo{{/str}}">
            <i class="fa fa-expand" aria-hidden="true"></i>
            <span data-code-expand-label>{{#str}}codeeditorfullscreen, theme_learnlingo{{/str}}</span>
        </button>
    </div>
    <div class="ll-code-editor__workspace">
        <div class="ll-code-editor__gutter" data-code-gutter aria-hidden="true"></div>
        <div class="ll-code-editor__area">
            <pre class="ll-code-editor__highlight" data-code-highlight aria-hidden="true"><code></code></pre>
            <textarea id="{{id}}" name="{{name}}" cols="{{cols}}" rows="{{rows}}"
                class="ll-code-editor__input form-control" dir="ltr"
                autocomplete="off" autocapitalize="off" spellcheck="false"
                aria-label="{{languageupper}}"
                {{#readonly}}disabled{{/readonly}}>{{value}}</textarea>
        </div>
    </div>
    <div class="ll-code-editor__footer">
        <span>{{#str}}codeeditorhint, theme_learnlingo{{/str}}</span>
        <span data-code-position></span>
    </div>
</div>
