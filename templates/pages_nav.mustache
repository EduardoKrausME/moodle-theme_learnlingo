{{!
    @template theme_learnlingo/pages_nav
    Links within the existing Moodle navbar, not a second navbar.
}}
{{#learnlingopagesnav.0}}
<ul class="navbar-nav d-none d-md-flex learnlingo-pages-nav" aria-label="{{#str}}custompagesmenu, theme_learnlingo{{/str}}">
    {{#learnlingopagesnav}}
        {{#haschildren}}
            <li class="nav-item dropdown">
                <a href="#" role="button" class="nav-link dropdown-toggle"
                    id="ll-page-category-{{sort}}" data-bs-toggle="dropdown"
                    aria-expanded="false">{{{text}}}</a>
                <ul class="dropdown-menu" aria-labelledby="ll-page-category-{{sort}}">
                    {{#children}}
                        <li><a class="dropdown-item" href="{{{url}}}">{{{text}}}</a></li>
                    {{/children}}
                </ul>
            </li>
        {{/haschildren}}
        {{^haschildren}}
            <li class="nav-item"><a class="nav-link" href="{{{url}}}">{{{text}}}</a></li>
        {{/haschildren}}
    {{/learnlingopagesnav}}
</ul>
{{/learnlingopagesnav.0}}
