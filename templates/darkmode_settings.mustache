{{!
    @template theme_learnlingo/darkmode_settings
    Displays the optional plugin installation link inside Moodle's admin settings
    form without introducing a nested form.
}}
<div class="ll-darkmode-settings">
    <div class="card">
        <div class="card-header">{{#str}}darkmodeheading, theme_learnlingo{{/str}}</div>
        <div class="card-body">
            {{#str}}darkmodeintro, theme_learnlingo, {{{installurl}}}{{/str}}
        </div>
    </div>
</div>
